PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/feduwo_agri_consultant
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
